name: Build Muguet IPA

on:
  workflow_dispatch: 

jobs:
  build:
    runs-on: macos-14 

    steps:
      - name: 檢查程式碼
        uses: actions/checkout@v4

      - name: 安裝特定版本的 Rust
        run: |
          rustup toolchain install 1.98.1
          rustup default 1.98.1
          rustup target add aarch64-apple-ios --toolchain 1.98.1

      - name: 安裝 xcodegen
        run: brew install xcodegen

      - name: 編譯與打包
        run: |
          xcodegen generate
          echo "請在這裡補上專案對應的打包指令"

      - name: 上傳打包好的 IPA 檔案
        uses: actions/upload-artifact@v4
        with:
          name: Muguet-IPA
          path: |
            *.ipa
            
